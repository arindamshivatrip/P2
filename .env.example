# Copy to .env.local and fill in. On Vercel, add the same names under
# Project Settings > Environment Variables.

# Primary model: google | anthropic. AI_MODEL is optional.
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Optional fallback, used when the primary call fails.
AI_FALLBACK_PROVIDER=google
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=

# Rate limiting (production). Leave empty locally to skip it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a separate Upstash database for the footer visitor counter, so its
# traffic can't use up the commands the chat rate limiter needs. Falls back to
# the database above when empty.
PRESENCE_REDIS_REST_URL=
PRESENCE_REDIS_REST_TOKEN=

# Optional: a long random string. Enables removing a note from the Messages
# wall with DELETE /api/messages (Authorization: Bearer <token>, body {"id"}).
MESSAGES_ADMIN_TOKEN=
